# Production template — copy to .env on the server and fill in.
# Everything here differs from local on purpose; the comments say why.

APP_NAME="HMS India"
APP_ENV=production
# Off, or a stack trace exposes file paths, queries and env values to anyone
# who can trigger an error.
APP_DEBUG=false
APP_KEY=
# Must be https:// — the mobile app sends its bearer token and patient data
# on every request, and plain http puts both on the wire in the clear.
APP_URL=https://hms.example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hms
DB_USERNAME=hms
# A real password, and not the root account: patient fields are encrypted
# with APP_KEY, but schema and relationships are not.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies only over TLS, and not readable from JavaScript.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Browser origins allowed to call the API, comma-separated. The Flutter app
# is not a browser, so it doesn't need to be listed here.
CORS_ALLOWED_ORIGINS=https://hms.example.com

# Domains that may authenticate with Sanctum's cookie flow.
SANCTUM_STATEFUL_DOMAINS=hms.example.com

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# After filling this in, on the server:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# And in front of PHP: TLS (Let's Encrypt), HTTP->HTTPS redirect, and HSTS.
# Build the app against it with:
#   flutter build apk --dart-define=API_URL=https://hms.example.com/api
# then delete android/app/src/main/res/xml/network_security_config.xml and
# its manifest reference, so the app can no longer talk plain http.
